# Chiave API per Google Maps Routes API v2
# Se lasciata vuota, il sistema utilizzerà automaticamente il motore di routing open source (OSRM + Geocoding Nominatim)
GOOGLE_MAPS_API_KEY=

# Prezzi carburante medi di default (€/litro)
DEFAULT_GASOLINE_PRICE=1.85
DEFAULT_DIESEL_PRICE=1.75
DEFAULT_LPG_PRICE=0.72
DEFAULT_CNG_PRICE=1.35
DEFAULT_ELECTRIC_PRICE_KWH=0.40
